# Anthropic API Key (required)
ANTHROPIC_API_KEY=sk-ant-...

# Default model (optional, defaults to claude-opus-5)
AGENT_MODEL=claude-opus-5

# Log level: debug | info | warn | error (optional, defaults to info)
AGENT_LOG_LEVEL=info

# Session storage directory (optional, defaults to ~/.agent-app/sessions)
AGENT_SESSION_DIR=

# Max concurrent tool executions (optional, defaults to 4). Only calls that
# change nothing run concurrently; Bash, Write and Edit always run one at a time.
AGENT_MAX_CONCURRENT_TOOLS=4

# Most characters of one tool result the model sees (optional, defaults to 40000)
AGENT_MAX_TOOL_OUTPUT=

# A bash-compatible shell for the Bash tool (optional). By default: /bin/bash,
# or Git Bash on Windows, or cmd.exe when neither is found.
AGENT_SHELL=

# ripgrep for the Grep tool, if it is not on PATH (optional)
AGENT_RG_PATH=

# Risk gate (needed by --gate, whose default backend is llm)
# The judge reads token probabilities, which the Anthropic Messages API does
# not expose, so it talks to an OpenAI-compatible endpoint of its own.
# A local Ollama works and needs no real key:
#   AGENT_JUDGE_API_KEY=ollama
#   AGENT_JUDGE_BASE_URL=http://localhost:11434/v1
#   AGENT_JUDGE_MODEL=llama3.1:8b
AGENT_JUDGE_API_KEY=
AGENT_JUDGE_BASE_URL=
AGENT_JUDGE_MODEL=

# The endpoint must return logprobs, and the model must answer in its first
# token. Reasoning models emit <think> first and will not work. The CLI probes
# once at startup and turns the gate off rather than running a judge that
# cannot answer; --gate allowlist is the offline fallback.
