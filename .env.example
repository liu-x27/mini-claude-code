# Anthropic API Key (required)
ANTHROPIC_API_KEY=sk-ant-...

# Default model (optional, defaults to claude-opus-5)
AGENT_MODEL=claude-opus-5

# Log level: debug | info | warn | error (optional, defaults to info)
AGENT_LOG_LEVEL=info

# Session storage directory (optional, defaults to ~/.agent-app/sessions)
AGENT_SESSION_DIR=

# Max concurrent tool executions (optional, defaults to 4)
AGENT_MAX_CONCURRENT_TOOLS=4

# Risk gate (optional, --gate llm only)
# The judge backend reads token probabilities, which the Anthropic Messages API
# does not expose, so it talks to an OpenAI-compatible endpoint of its own.
AGENT_JUDGE_API_KEY=
AGENT_JUDGE_BASE_URL=
AGENT_JUDGE_MODEL=

# The endpoint must return logprobs, and the model must answer in its first
# token. Reasoning models emit <think> first and will not work.
