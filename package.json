{
  "name": "agent-app",
  "version": "0.1.0",
  "description": "A production-grade, extensible Agent framework powered by Claude",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc -p tsconfig.check.json",
    "server": "npx tsx server/index.ts",
    "client": "vite client",
    "cli": "npx tsx cli/index.ts",
    "dev": "npx tsx server/index.ts",
    "example:basic": "npx tsx examples/01-basic.ts",
    "example:tools": "npx tsx examples/02-with-tools.ts",
    "example:stream": "npx tsx examples/03-streaming.ts",
    "example:multi-turn": "npx tsx examples/04-multi-turn.ts",
    "example:subagents": "npx tsx examples/05-subagents.ts",
    "test": "npx tsx examples/00-mock-test.ts",
    "eval:risk-gate": "npx tsx eval/risk-gate/run.ts",
    "eval:routing": "npx tsx eval/routing/run.ts",
    "eval:snake": "npx tsx eval/snake/run.ts",
    "eval:flappy": "npx tsx eval/flappy/run.ts",
    "eval:throughput": "npx tsx eval/throughput/run.ts",
    "eval:retry": "npx tsx eval/retry/run.ts",
    "lint": "biome lint src/ cli/",
    "format": "biome format --write src/ cli/"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.127.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "chalk": "^5.3.0",
    "express": "^5.2.1",
    "glob": "^11.0.0",
    "openai": "^6.33.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@types/bun": "latest",
    "@types/express": "^5.0.6",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "tsx": "^4.23.15",
    "typescript": "^5.6.0",
    "vite": "^8.0.3"
  },
  "bin": {
    "agent-app": "./cli/index.ts"
  }
}
