{
  "name": "agent-app",
  "version": "0.1.0",
  "description": "A production-grade, extensible Agent framework powered by Claude",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "server": "npx tsx server/index.ts",
    "client": "vite client",
    "dev": "npx tsx server/index.ts",
    "example:basic": "npx tsx examples/01-basic.ts",
    "example:tools": "npx tsx examples/02-with-tools.ts",
    "example:stream": "npx tsx examples/03-streaming.ts",
    "example:multi-turn": "npx tsx examples/04-multi-turn.ts",
    "example:subagents": "npx tsx examples/05-subagents.ts",
    "test": "npx tsx examples/00-mock-test.ts",
    "lint": "biome lint src/",
    "format": "biome format --write src/"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.55.0",
    "chalk": "^5.3.0",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "glob": "^11.0.0",
    "openai": "^6.33.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@types/bun": "latest",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "typescript": "^5.6.0",
    "vite": "^8.0.3"
  }
